DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/capstone_db?schema=public"
JWT_SECRET="replace_this_with_a_long_random_secret"
PORT=5000
FRONTEND_URL="http://localhost:5173"

# Optional: required only for product image storage. Server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional local defense/demo seed. Do not enable against production.
DEMO_SEED=false
DEMO_ADMIN_EMAIL="admin.demo@example.invalid"
DEMO_ADMIN_USERNAME="demo-admin"
DEMO_ADMIN_PASSWORD=""
DEMO_STAFF_EMAIL="staff.demo@example.invalid"
DEMO_STAFF_USERNAME="demo-staff"
DEMO_STAFF_PASSWORD=""
